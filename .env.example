# Local demo defaults. Copy this file to .env before running Docker Compose.
# Never commit .env or place cloud credentials in it.
FINOP_ENVIRONMENT=development
FINOP_MOCK_MODE=true
FINOP_ALLOW_MOCK_FALLBACK=false
FINOP_API_KEY=
FINOP_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
FINOP_METRICS_REFRESH_SECONDS=15

# Required by Docker Compose; choose strong, unique credentials.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-before-sharing

# Set FINOP_MOCK_MODE=false and configure any providers you use.
FINOP_AWS_REGION=us-east-1
FINOP_AZURE_SUBSCRIPTION_ID=
